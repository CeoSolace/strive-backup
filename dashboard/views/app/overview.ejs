<% layout('layouts/app') -%>
<%
  const botGuilds = client?.guilds?.cache?.size || 0;
  const uptimeMinutes = client?.uptime ? Math.floor(client.uptime / 60000) : 0;
  const uptime = uptimeMinutes > 60 ? `${Math.floor(uptimeMinutes / 60)}h ${uptimeMinutes % 60}m` : `${uptimeMinutes}m`;
  const managedGuilds = user?.displayedGuilds || user?.guilds || [];
  const visibleGuilds = managedGuilds.slice(0, 6);
%>

<section class="space-y-8">
  <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-indigo-500/20 via-sky-500/10 to-transparent p-6 shadow-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200/80">Bright Dashboard</p>
    <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-3xl font-black text-white md:text-5xl">Welcome back, <%= user ? (user.global_name || user.username || 'User') : 'User' %></h1>
        <p class="mt-3 max-w-2xl text-white/65">Manage your servers, commands, modules, audit logs and account settings from one cleaner control panel.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/app/servers" class="rounded-2xl bg-sky-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-sky-300">Manage servers</a>
        <a href="/app/analytics" class="rounded-2xl border border-white/10 px-5 py-3 font-bold text-white transition hover:bg-white/10">View analytics</a>
      </div>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-sm text-white/50">Bot status</p>
      <p class="mt-2 text-3xl font-black text-emerald-300">Online</p>
      <p class="mt-1 text-sm text-white/45">Live and ready</p>
    </div>
    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-sm text-white/50">Bot servers</p>
      <p class="mt-2 text-3xl font-black text-white"><%= botGuilds %></p>
      <p class="mt-1 text-sm text-white/45">Connected guilds</p>
    </div>
    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-sm text-white/50">Your access</p>
      <p class="mt-2 text-3xl font-black text-white"><%= managedGuilds.length %></p>
      <p class="mt-1 text-sm text-white/45">Servers you can manage</p>
    </div>
    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5">
      <p class="text-sm text-white/50">Uptime</p>
      <p class="mt-2 text-3xl font-black text-white"><%= client?.uptime ? uptime : 'N/A' %></p>
      <p class="mt-1 text-sm text-white/45">Current session</p>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1.4fr_0.8fr]">
    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-2xl font-black text-white">Your servers</h2>
          <p class="mt-1 text-sm text-white/50">Jump straight into the servers you can manage.</p>
        </div>
        <a href="/app/servers" class="text-sm font-bold text-sky-300 hover:text-sky-200">View all</a>
      </div>

      <% if (visibleGuilds.length > 0) { %>
        <div class="mt-5 grid gap-3 md:grid-cols-2">
          <% visibleGuilds.forEach((guild) => { %>
            <a href="/manage/<%= guild.id %>" class="rounded-2xl border border-white/10 bg-black/20 p-4 transition hover:-translate-y-0.5 hover:border-sky-300/40 hover:bg-sky-400/10">
              <p class="font-black text-white"><%= guild.name %></p>
              <p class="mt-1 text-xs text-white/45">ID: <%= guild.id %></p>
              <p class="mt-3 text-sm font-bold text-sky-300">Open settings →</p>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="mt-5 rounded-2xl border border-dashed border-white/15 p-6 text-white/60">No manageable servers found. Make sure you have Manage Guild permission or invite Bright first.</div>
      <% } %>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
      <h2 class="text-2xl font-black text-white">Account</h2>
      <div class="mt-5 rounded-2xl bg-black/20 p-4">
        <p class="text-sm text-white/45">Signed in as</p>
        <p class="mt-1 font-black text-white"><%= user?.username || 'User' %></p>
        <p class="mt-1 break-all text-xs text-white/40"><%= user?.id || 'No Discord ID loaded' %></p>
      </div>
      <div class="mt-4 grid gap-3">
        <a href="/app/account/profile" class="rounded-2xl border border-white/10 px-4 py-3 font-bold text-white hover:bg-white/10">Profile settings</a>
        <a href="/app/privacy-consent" class="rounded-2xl border border-white/10 px-4 py-3 font-bold text-white hover:bg-white/10">Privacy & consent</a>
        <a href="/logout" class="rounded-2xl border border-red-400/20 px-4 py-3 font-bold text-red-200 hover:bg-red-400/10">Sign out</a>
      </div>
    </div>
  </div>
</section>
